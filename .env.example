# Copy to .env.local. Without the Supabase values the site runs on sample data.

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin, used for metadata and the calendar feed
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin WeChat QR shown after joining (image URL or /path in public/)
NEXT_PUBLIC_ADMIN_WECHAT_QR=
