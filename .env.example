# Copy to .env.local. Without the Supabase values the site runs on sample data.

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin for metadata and the calendar feed. Optional on Vercel (defaults
# to the production domain); set it for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin WeChat QR shown after joining. Defaults to public/admin-wechat-qr.jpg;
# set an image URL here to swap admins without a code change.
NEXT_PUBLIC_ADMIN_WECHAT_QR=
